# Local test aid for tests/validate.sh (see tests/requirements.txt).
.venv/
# Scanners the gate fetches: hadolint. It is fetched into the tree rather
# than into .venv, so `tests/bootstrap.sh` owns one install location for it
# whether it is bootstrapping into this tree or another. See
# tests/bootstrap.sh.
tests/.bin/
__pycache__/
*.pyc
.DS_Store

# The fingerprint cache: one gate's verdicts, keyed by content. Local, never
# committed, and safe to delete at any time -- deleting it costs one slow run.
.kit/cache/
# Live stack snapshots — derived, never committed (#m154). Without this the
# sync's own `.kit/live/<ref>/.gitignore` (`*` + `!.gitignore`) leaves its
# `.gitignore` untracked, so `git status --untracked-files=all` would report
# the snapshot rather than ignoring it. This line ignores the whole subtree in
# one place, so a snapshot can never become a tracked or dirty state.
.kit/live/
# The launch harness's generated credentials — stable dev secrets, never
# committed. launch/bin/launch writes this; the overlay reads it.
launch/.env
