# Local test aid for tests/validate.sh (see tests/requirements.txt).
.venv/
# Scanners the gate fetches: hadolint. It is fetched into the tree rather
# than into .venv, so `tests/bootstrap.sh` owns one install location for it
# whether it is bootstrapping into this tree or another. See
# tests/bootstrap.sh.
tests/.bin/
__pycache__/
*.pyc
.DS_Store

# The fingerprint cache: one gate's verdicts, keyed by content. Local, never
# committed, and safe to delete at any time -- deleting it costs one slow run.
.kit/cache/
