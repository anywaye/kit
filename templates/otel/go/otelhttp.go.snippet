// kit template — wire W3C trace propagation into a Go service with the
// upstream OpenTelemetry SDK, instead of the hand-rolled codec.
//
// THIS IS THE SUPPORTED PATH FOR A NEW SERVICE. `traceparent.go` exists for the
// cases the SDK does not cover: a NATS consumer with no HTTP server, a webhook
// signer, a test that asserts propagation without standing up a tracer. If you
// are writing an HTTP service or making HTTP calls, use this file.
//
// This is a SNIPPET, not a file to copy verbatim: the import paths and the
// constructor names are the ones as of the versions pinned in pins.md, and
// `go get` is how you take the dependency. kit vendors nothing.
//
// WHAT IT DOES FOR YOU
//   - Reads an inbound `traceparent` and continues it (the SDK's propagator is
//     W3C TraceContext by default; this is stated explicitly rather than assumed,
//     because a service that constructs its own propagator can silently get the
//     B3 one).
//   - Writes `traceparent` and `tracestate` on every outbound request.
//   - Never rejects a request over a malformed header. The SDK's error handler is
//     set to log-and-continue, because §3.2.2.3 says to ignore the header, not to
//     fail the request.
//
// OBSERVABILITY IS ON BY DEFAULT (PLAN.md §7b)
//   A developer working on this service sees real traces without turning
//   anything on, because `CAF_OTEL_ENDPOINT` DEFAULTS to the collector that
//   ships with the stack. Unsetting it is a genuine no-op; setting it to
//   somebody else's OTLP endpoint is a supported deployment, not a degraded
//   mode. The variable name is `<SERVICE>_OTEL_ENDPOINT` and that is the ONLY
//   contract — see `endpoint()` below for the whole of it in one function.
//
// SPEC: W3C Trace Context, W3C Recommendation 23 November 2021
//       https://www.w3.org/TR/trace-context/
// The SDK implements these sections; see traceparent.go for the section-by-
// section list if you need to know which rules your version covers.
//
// ---------------------------------------------------------------------------
// go get go.opentelemetry.io/otel@v1.46.0
// go get go.opentelemetry.io/otel/sdk@v1.46.0
// go get go.opentelemetry.io/otel/trace@v1.46.0
// go get go.opentelemetry.io/otel/exporters/otlp/otlptrace@v1.46.0
// go get go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.46.0
// go get go.opentelemetry.io/otel/metric@v1.46.0
// go get go.opentelemetry.io/otel/sdk/metric@v1.46.0
// go get go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc@v1.46.0
// go get go.opentelemetry.io/otel/log@v0.11.0
// go get go.opentelemetry.io/otel/sdk/log@v0.11.0
// go get go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp@v0.63.0
//
// These were 1.34.0 / 0.59.0 and every one resolved — which is exactly why the
// staleness went unnoticed for as long as it did. The three Go services in the
// fleet (identity, gateway, pantry) all run 1.46.0, so that is what this names
// now. See ../pins.md.
// ---------------------------------------------------------------------------

package telemetry

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"strings"
	"time"

	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/codes"
	otlplog "go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc"
	otlpmetric "go.opentelemetry.io/otel/exporters/otlp/otlpmetric/otlpmetricgrpc"
	otlptrace "go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
	"go.opentelemetry.io/otel/log"
	"go.opentelemetry.io/otel/log/global"
	"go.opentelemetry.io/otel/propagation"
	sdklog "go.opentelemetry.io/otel/sdk/log"
	sdkmetric "go.opentelemetry.io/otel/sdk/metric"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
	"go.opentelemetry.io/otel/trace"
	"go.opentelemetry.io/otel/trace/noop"
)

// ServiceName is the emitting service. Rename it to yours; it is the one value
// in this file that cannot be a default.
const ServiceName = "caf"

// defaultEndpoint is the collector that ships with the local stack. It is a
// DEFAULT VALUE, not a constant, and that is the whole of "on by default": a
// developer with no configuration exports into a collector on their own
// machine, and a self-hoster who already runs a backend sets the variable and
// this address goes quiet.
//
// PORT 4317, NOT 4318, and the pairing with the exporter below is the whole
// point of writing it here. This file installs `otlptracegrpc`, which speaks
// OTLP over gRPC; 4317 is that receiver. It previously defaulted to
// `http://otel-collector:4318`, which is the HTTP receiver's port — so the
// exporter dialled a port whose gRPC server does not exist, and every export
// failed. Nothing threw and nothing logged, which is the shape of both exporter
// defects documented in README.md.
//
// The two defaults in this file disagreed: the endpoint said 4318 and the
// transport was gRPC. Fixing either alone leaves the service exporting nowhere,
// so both are named together here.
//
// Read README.md §"The two exporter defects" before changing either half. The
// scheme `http://` is load-bearing, not decoration: it is what makes
// `WithEndpointURL` set `Insecure` (see the SDK's otlpconfig), so the gRPC dial
// is plaintext against the plaintext collector.
const defaultEndpoint = "http://otel-collector:4317"

// Endpoint is the ONLY contract, and it is deliberately the smallest possible
// amount of logic (core D16).
//
//	CAF_OTEL_ENDPOINT set   -> export there. Datadog, Honeycomb, Grafana Cloud,
//	                            or the shipped collector. Bring-your-own is a
//	                            supported deployment, not a degraded mode.
//	CAF_OTEL_ENDPOINT unset -> a genuine no-op: no exporter, no queue, no retry
//	                            loop against a dead endpoint, no warning per
//	                            request, no dial at boot. See NoOpReason.
//
// The standard `OTEL_EXPORTER_OTLP_ENDPOINT` is honoured as a fallback so the
// service also works with any generic OTel tooling, but the anywaye name wins
// when both are set. That ordering is written down here rather than discovered
// later: a contract with an undocumented precedence order is a bug report.
func Endpoint() string {
	if v := os.Getenv("CAF_OTEL_ENDPOINT"); v != "" {
		return v
	}
	if v := os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT"); v != "" {
		return v
	}
	return defaultEndpoint
}

// Enabled reports whether there is anywhere to export to.
//
// The two switches, in the order the OTel spec means them:
//   - OTEL_SDK_DISABLED is the spec's OWN kill switch, and it is the mechanism
//     core's otel-endpoint schema pins the no-op to. Re-implementing
//     "disabled" in six languages is how six services acquire six different
//     definitions of it, and the difference between them is somebody's
//     production incident.
//   - OTEL_TRACES_EXPORTER=none / OTEL_METRICS_EXPORTER=none /
//     OTEL_LOGS_EXPORTER=none are the finer-grained per-signal half. A no-op
//     that only covers traces is a service that still phones home for metrics,
//     which is the failure discovered by a customer's invoice rather than by a
//     test — so all three are checked, not just the first.
func Enabled() bool {
	if stringsEqualFold(os.Getenv("OTEL_SDK_DISABLED"), "true") {
		return false
	}
	return exporterEnabled("OTEL_TRACES_EXPORTER")
}

func exporterEnabled(name string) bool {
	return !stringsEqualFold(os.Getenv(name), "none")
}

// NoOpReason is one line for a startup log, and only ever on the DISABLED path.
// Silence is the contract there: a service that logs a warning per export
// attempt fills its own log store with the fact that telemetry is off, which is
// how a self-hoster discovers that turning it off is not supported — the
// opposite of the intent. One line at startup is not spam and is the difference
// between "telemetry is off" and "telemetry is broken", which look identical
// from outside.
func NoOpReason() string {
	switch {
	case stringsEqualFold(os.Getenv("OTEL_SDK_DISABLED"), "true"):
		return "OTEL_SDK_DISABLED=true"
	case !exporterEnabled("OTEL_TRACES_EXPORTER"):
		return "OTEL_TRACES_EXPORTER=none"
	}
	return ""
}

func stringsEqualFold(got, want string) bool {
	return strings.EqualFold(got, want)
}

// resource is the process identity, attached once per process rather than once
// per span. It is the correct home for tenancy and service metadata and it is
// EXEMPT from OpenTelemetry's 2000-attribute-combination metric cap, which is
// why `tenant_id` goes here and never on a measurement: put it on a
// measurement and the moment that stream overflows, every per-tenant
// breakdown silently undercounts while the total stays right.
func resource(serviceName, serviceVersion string) *attribute.Resource {
	attrs := []attribute.KeyValue{
		attribute.String("service.name", serviceName),
		attribute.String("service.version", serviceVersion),
		attribute.String("deployment.environment", os.Getenv("DEPLOYMENT_ENVIRONMENT")),
	}
	if tenant := os.Getenv("CAF_TENANT_ID"); tenant != "" {
		attrs = append(attrs, attribute.String("tenant_id", tenant))
	}
	return attribute.NewResource(attrs...)
}

// Shutdown flushes every signal. Missing it loses the last batch, which is
// usually the batch containing the error you were restarting to look at.
type Shutdown func(context.Context) error

// Install sets the propagator and every signal provider, and returns one
// Shutdown for all of them.
//
// A no-op provider per signal when telemetry is off, never a provider pointed
// at nothing: a provider with no exporter still allocates a span per request,
// still computes attributes nobody reads, and still costs a goroutine. The
// no-op is genuinely free, which is what core's no-op schema demands.
func Install(ctx context.Context, serviceName, serviceVersion string) (Shutdown, error) {
	// W3CTraceContext named explicitly rather than left to the default. The
	// default IS W3C today, but otel.SetTextMapPropagator is called by several
	// libraries that may not mean what you do, and a service that depends on a
	// default it never wrote down breaks silently when one of them changes it.
	otel.SetTextMapPropagator(propagation.NewCompositeTextMapPropagator(
		propagation.TraceContext{}, // W3C traceparent + tracestate
		propagation.Baggage{},      // W3C baggage; a separate header, same spec
	))

	if !Enabled() {
		otel.SetTracerProvider(noop.NewTracerProvider())
		otel.SetMeterProvider(noop.NewMeterProvider())
		global.SetLoggerProvider(noop.NewLoggerProvider())
		return func(context.Context) error { return nil }, nil
	}

	endpoint := Endpoint()

	// `WithEndpointURL`, and both exporter defects documented in README.md turn
	// on this one line:
	//
	//   * It reads the SCHEME. `cfg.Traces.Insecure = u.Scheme != "https"`, so
	//     the `http://` in defaultEndpoint is what makes this gRPC dial
	//     PLAINTEXT against the plaintext collector. Swapping in
	//     `WithEndpoint("host:4317")` — bare, no scheme to read — leaves
	//     `Insecure` at its default of `false` and the handshake never
	//     completes. That is the bug caf shipped, and it exported nothing at all
	//     while looking perfectly healthy.
	//   * It does NOT append a signal path — but for gRPC that is CORRECT, and
	//     the SDK says so itself: `URLPath` is ignored by gRPC exporters, because
	//     the protocol carries the signal in the method name. Do not "fix" this
	//     by joining `/v1/traces` onto the endpoint. The OTLP/HTTP exporter is
	//     the one that needs the append, and README.md explains why.
	//
	// Order matters and is documented in both options: if `WithEndpoint` and
	// `WithEndpointURL` are both passed, the LAST one wins. There is only one
	// here on purpose.
	spanExporter, err := otlptrace.New(ctx, otlptrace.WithEndpointURL(endpoint))
	if err != nil {
		return nil, fmt.Errorf("otlp trace exporter: %w", err)
	}
	// A sampler that respects the caller's decision rather than re-deciding per
	// hop. ParentBased(AlwaysSample) is the combination that matters: a service
	// that samples independently produces traces with holes, which are worse to
	// debug than no traces at all.
	tracerProvider := sdktrace.NewTracerProvider(
		sdktrace.WithBatcher(spanExporter),
		sdktrace.WithSampler(sdktrace.ParentBased(sdktrace.AlwaysSample())),
		sdktrace.WithResource(resource(serviceName, serviceVersion)),
	)
	otel.SetTracerProvider(tracerProvider)

	metricExporter, err := otlpmetric.New(ctx, otlpmetric.WithEndpointURL(endpoint))
	if err != nil {
		// One failed signal does not take the others down. A service with
		// traces and no metrics is far more useful than a service that refuses
		// to start because a meter could not be built.
		otel.SetMeterProvider(noop.NewMeterProvider())
	} else {
		otel.SetMeterProvider(sdkmetric.NewMeterProvider(
			sdkmetric.WithReader(sdkmetric.NewPeriodicReader(metricExporter)),
			sdkmetric.WithResource(resource(serviceName, serviceVersion)),
		))
	}

	logExporter, err := otlplog.New(ctx, otlplog.WithEndpointURL(endpoint))
	if err != nil {
		global.SetLoggerProvider(noop.NewLoggerProvider())
	} else {
		// Batch, never simple: one export per record makes the collector the
		// bottleneck and drops records on a slow network.
		global.SetLoggerProvider(sdklog.NewLoggerProvider(
			sdklog.WithProcessor(sdklog.NewBatchProcessor(logExporter)),
			sdklog.WithResource(resource(serviceName, serviceVersion)),
		))
	}

	return func(shutdownCtx context.Context) error {
		var errs []error
		// Bounded, because a telemetry flush must not be able to hold up a
		// shutdown: a service that takes 30s to stop because a collector is
		// unreachable is a deploy that times out for a reason nobody can see.
		flushCtx, cancel := context.WithTimeout(shutdownCtx, 5*time.Second)
		defer cancel()
		if err := tracerProvider.Shutdown(flushCtx); err != nil {
			errs = append(errs, err)
		}
		if err := global.GetMeterProvider().Shutdown(flushCtx); err != nil {
			errs = append(errs, err)
		}
		if err := global.GetLoggerProvider().Shutdown(flushCtx); err != nil {
			errs = append(errs, err)
		}
		return errors.Join(errs...)
	}, nil
}

// Handler wraps an http.Handler so inbound requests continue their trace and
// outbound requests carry it.
//
// `otelhttp.NewHandler` does both halves. The important part is that it reads
// the inbound header for you: a handler that starts a fresh span per request
// without extracting the caller's context is the single most common way a Go
// service ends up with 4000 one-hop traces instead of 200 four-hop ones.
//
// The span name is set explicitly to the fleet's form, `<service>.<operation>`,
// and NOT left to the SDK default. The OTel HTTP convention would name it
// `GET /v1/users/{id}`, which puts the route in the NAME — and a name is the
// grouping key in every trace UI, so an attribute in the name is an attribute
// that cannot be filtered out, and a route with an id in it is a cardinality
// explosion with a GET attached. core's span-naming schema caps each segment at
// fifteen characters, which is what makes an interpolated id impossible to
// spell even by accident.
func Handler(operation string, next http.Handler) http.Handler {
	return otelhttp.NewHandler(
		next,
		ServiceName+"."+operation,
		otelhttp.WithSpanOptions(otelhttp.SpanOptions{
			// The ROUTE TEMPLATE, never the concrete path, and it goes on as an
			// ATTRIBUTE — the name above is the operation and the name is the
			// grouping key in every trace UI. `/v1/users/{id}` has one value per
			// endpoint; `/v1/users/usr_01J9...` has one per request, and
			// `url.path` and `url.full` are not on core's allowlist for exactly
			// this reason.
			Filter: func(r *http.Request) bool { return true },
		}),
	)
}

// Client is an http.Client that injects the current trace into every request.
//
// Use this rather than http.DefaultClient for service-to-service calls. A
// request made with a bare client breaks the trace at that hop, silently and
// permanently, with no error anywhere to grep for.
func Client() *http.Client {
	return &http.Client{Transport: otelhttp.NewTransport(http.DefaultTransport)}
}

// StartServerSpan begins a span for an inbound request that is not going through
// an http.Handler — a gRPC method, a queue consumer, a cron tick.
//
// The propagator does the extracting; the carrier is the header map the
// framework gave you. On a malformed header this returns the original ctx
// unchanged and a nil remote span, which is exactly §3.2.2.3's "ignore the
// header" — not an error, and not a 4xx.
func StartServerSpan(ctx context.Context, tracer trace.Tracer, operation string, headers map[string]string) (context.Context, trace.Span) {
	ctx = otel.GetTextMapPropagator().Extract(ctx, propagation.MapCarrier(headers))
	return tracer.Start(ctx, ServiceName+"."+operation)
}

// RecordFailure marks a span as ERRORED and attaches the bounded error CLASS.
//
// TWO THINGS HERE, AND THE SECOND IS THE POINT.
//
//  1. `SetStatus(codes.Error, ...)` is what makes the span an error AT ALL. The
//     predicate for "this is an error" is span status, not error.type — a
//     span whose status is unset is invisible to a `{status=error}` filter
//     however many error attributes it carries.
//
//  2. `error.type` is the CLASS, never the message. It is snake_case, at most
//     64 characters, drawn from a vocabulary the whole fleet shares, and
//     `RecordError` is deliberately NOT called here: the SDK's RecordError
//     records `exception.message`, and a message is unbounded, is a cardinality
//     bomb on the metrics side, and on an LLM gateway is a prompt by another
//     route — a provider's content-policy rejection quotes the offending
//     content back at you. core's redaction schema prohibits the attribute by
//     name for exactly that reason.
//
// So: map your error to a class and pass THAT. `class` is validated rather than
// trusted, because an invalid one is dropped by the collector anyway and a
// silently-missing drill-down is worse than a loud one.
func RecordFailure(span trace.Span, class, staticDescription string) {
	span.SetStatus(codes.Error, staticDescription)
	span.SetAttributes(attribute.String("error.type", class))
}

// LogException emits an EXCEPTION LOG RECORD, which is the current convention.
//
// The `exception` SPAN EVENT is Deprecated in favour of exactly this: a log
// record with an event name ending `.exception` and a severity chosen by
// EXPECTED IMPACT. The span event form is a compatibility shim, and a service
// still writing it has not migrated.
//
// Severity by impact, not by what the code found convenient: a single failed
// request for one caller is WARN, a request the service cannot serve is ERROR,
// and something that corrupts state or ends the process is FATAL.
//
// `error.type` goes on the record and the exception DETAIL does not: the
// collector drops `exception.message` and `exception.stacktrace` because they
// are on nobody's allowlist, and a stack trace is unbounded text. `class` is
// what survives, and `detail` is for the caller's own log — where it belongs.
func LogException(ctx context.Context, class, detail string, impact string) {
	severity := sdklog.SeverityWarn
	switch impact {
	case "error":
		severity = sdklog.SeverityError
	case "fatal":
		severity = sdklog.SeverityFatal
	}
	var rec log.Record
	rec.SetEventName("exception")
	rec.SetSeverity(severity)
	rec.SetBody(log.StringValue(detail))
	rec.AddAttributes(log.String("error.type", class), log.String("log.severity", severity.String()))
	global.GetLoggerProvider().Logger("caf").Emit(ctx, rec)
}
