{
  // kit-install — the install host: the Worker behind
  // cafaye.com/box/install.
  //
  // Serves templates/substrate/install.sh at GET /box/install: the exact
  // bytes, content-type text/x-shellscript, no transformation. GET / and GET
  // /install.sh answer the same bytes, so a Worker bound to a hostname of its
  // own behaves exactly as it did before the move — they are the cutover,
  // not a second front door. The decisions are in DEPLOYMENT.md; the
  // operator action (binding the route) is named in
  // templates/substrate/README.md and is NOT a file here.
  //
  // `main` is this directory's kit-install.mjs — plain ESM, so the gate
  // imports the handler as a plain module with no wrangler, no network and
  // no account (check_install_host in tests/validate.sh).
  //
  // `compatibility_date` pins the runtime the Worker is written against, so
  // a Cloudflare-side change cannot silently alter what this build does. It
  // is the fleet's number, unchanged from site's wrangler.jsonc: the BFF's
  // behaviour was measured on this runtime and kit's Worker is written
  // against the same one.
  //
  // `rules` is the mechanism that keeps the served bytes equal to the file:
  // the Text-module rule bundles install.sh's bytes into the Worker at
  // deploy time, so `import installSh from "./install.sh"` in kit-install.mjs
  // resolves to the file itself. There is no hand-copied second copy of the
  // script anywhere in the tree — a copy is a second author, and the gate's
  // hash comparison is what proves the two never drift.
  //
  // NO `routes` BLOCK, matching the fleet: measured, site/wrangler.jsonc
  // carries none, so the cafaye.com/box/install route is bound outside the
  // repositories and this Worker follows the same shape. Binding the route
  // is a Cloudflare route/custom-domain action — an operator step, not a
  // value this repository can verify.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kit-install",
  "compatibility_date": "2025-09-02",
  "main": "kit-install.mjs",
  "observability": {
    "enabled": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": false }]
}
