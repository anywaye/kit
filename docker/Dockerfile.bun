# kit template — Bun/TypeScript service image. Copy to docker/Dockerfile.
#
#   docker build -f docker/Dockerfile --build-arg BUN_VERSION=1.3.12 -t svc .
#
# STRICTNESS NOTES
#   - Two stages. The builder installs the full dev dependency tree and compiles;
#     the runtime stage installs production dependencies only, so nothing a test
#     needed is reachable in production.
#   - `oven/bun:*-slim`, never `oven/bun:*`: full Debian ships a browser and a
#     document toolchain a gateway or worker never calls. The digest-shaped tag
#     moves with a patch release; BUN_VERSION is the caller's pin, not a default.
#   - `bun install --frozen-lockfile` in BOTH stages, never `bun install`. Frozen
#     installs exactly bun.lock and fails if the lock and package.json disagree.
#     A plain install here would produce an image whose dependency tree nobody
#     reviewed, built from a lockfile the build itself rewrote.
#   - The final stage runs non-root, as `bun` (uid 1000), which the official
#     `oven/bun` image already ships — a container running as root is a container
#     where a bug is a host compromise. (The comment here used to say the image
#     has NO unprivileged user and that we create one. It does not: it ships
#     `bun` at uid 1000, verified against oven/bun:1.3.12-slim. The `useradd`
#     this note described was never in the file, so the note described a
#     different Dockerfile than the one being read.)
#   - THE ENTRYPOINT MIGRATES FIRST. `docker/entrypoint.sh` resolves this
#     repository's migration command, runs it against DATABASE_URL, and only then
#     `exec`s bun. A migration that fails refuses to start the service, which is
#     the point: it deletes the "service is healthy, schema is stale" cold-start
#     class that a bare `ENTRYPOINT ["bun", "run", …]` leaves open. Set
#     `KIT_MIGRATE=required` for a service that owns a schema, so a
#     misconfigured image fails loudly instead of serving the old one.
#     `docker/entrypoint.sh` finds `./bin/migrate` on its own; a Bun service with
#     no `bin/migrate` sets `KIT_MIGRATE_CMD`.
#   - `exec "$@"` inside that script, so after the migration bun replaces the
#     shell and is PID 1: SIGTERM still reaches it. There is still no init/tini,
#     and the reason is unchanged — after the exec there is no shell left to
#     swallow anything. The difference from the bare ENTRYPOINT this replaced is
#     that PID 1 is a shell for the duration of the migration only, and there
#     are no orphaned children to reap in that window.
ARG BUN_VERSION=1.3.12

FROM oven/bun:${BUN_VERSION}-slim AS build
WORKDIR /app
ENV CI=true
# The manifest and its lock together, before the source, so a source-only edit
# does not invalidate the dependency layer.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build --if-present

FROM oven/bun:${BUN_VERSION}-slim AS runtime
ENV NODE_ENV=production PORT=3000
WORKDIR /app

# --- the provenance stamp (kit) ----------------------------------------------
# Five ARGs, one file, five labels. WHICH formats this could have been, and the
# grammar that decides what may be stamped at all, are in docker/provenance.sh
# — do not restate them here, copy the script and read its header.
#
# `LABEL ${VAR}` is deliberately NOT used: buildkit does not word-split an
# expansion in a LABEL, so `LABEL ${STAMP}` fails with "must have two arguments"
# (measured). One ARG cannot carry five labels, so there are five.
#
# The defaults are `unknown` rather than empty, and that is the point: an image
# built with no --build-arg still carries the KEYS, because a missing label is
# indistinguishable from an image built before this existed.
ARG KIT_PROVENANCE_SOURCE=unknown
ARG KIT_PROVENANCE_REVISION=unknown
ARG KIT_PROVENANCE_BUILT_AT=unknown
ARG KIT_PROVENANCE_SOURCE_DIRTY=unknown
ARG KIT_PROVENANCE_TEMPLATE_VERSION=unknown
COPY docker/provenance.sh /usr/local/lib/kit/provenance.sh
RUN chmod +x /usr/local/lib/kit/provenance.sh \
    && /usr/local/lib/kit/provenance.sh --write /app/kit-provenance.json
LABEL org.opencontainers.image.source="${KIT_PROVENANCE_SOURCE}" \
      org.opencontainers.image.revision="${KIT_PROVENANCE_REVISION}" \
      org.opencontainers.image.created="${KIT_PROVENANCE_BUILT_AT}" \
      com.anywaye.kit.source.dirty="${KIT_PROVENANCE_SOURCE_DIRTY}" \
      com.anywaye.kit.template.version="${KIT_PROVENANCE_TEMPLATE_VERSION}"

# node_modules is copied from the build stage rather than reinstalled: a second
# `bun install` in the runtime stage is a second chance for the resolved tree to
# differ from the one that was built and tested. See the frozen-install note.
COPY --from=build --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/dist ./dist
COPY --from=build --chown=bun:bun /app/package.json ./package.json
COPY --chown=bun:bun . .
COPY --chown=bun:bun docker/entrypoint.sh /app/kit-entrypoint

USER bun
EXPOSE 3000
ENTRYPOINT ["/bin/sh", "/app/kit-entrypoint", "bun", "run", "src/index.ts"]
