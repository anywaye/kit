# kit template — Python service image. Copy to docker/Dockerfile in the repo.
#
#   docker build -f docker/Dockerfile --build-arg PYTHON_VERSION=3.13 -t svc .
#
# STRICTNESS NOTES
#   - Two stages. The builder carries build-essential for wheels that still
#     compile; the runtime image carries no compiler at all, so a wheel that
#     needed to compile fails here — which is where you want to find out.
#   - `python:*-slim`, never `python:*`: full Debian ships a browser and a
#     document toolchain a service never calls.
#   - Wheels are built into /wheels and installed with --no-index, so the
#     runtime stage never reaches a package index at build time. Without that
#     flag a compromised index is a production compromise.
#   - The final stage runs non-root, as `app` (uid 10001), created with a fixed
#     numeric uid so the image is reproducible. A container running as root is a
#     container where a bug is a host compromise.
#   - uv is the resolver of record (see the CI job and templates/bin-prime); pip
#     remains only as the documented fallback, and it is not installed here.
#   - UV_VERSION is pinned because the resolver's own version changes what it
#     resolves. A bare `pip install uv` is a different lockfile on every day
#     uv ships a release, which makes the image unreproducible for a reason
#     that has nothing to do with the service. Kept in step with the `uv` pin
#     in templates/mise.toml; hadolint's DL3013 is what found this.
#   - THE ENTRYPOINT MIGRATES FIRST. `docker/entrypoint.sh` resolves this
#     repository's migration command, runs it against DATABASE_URL, and only then
#     `exec`s python. A migration that fails refuses to start the service, which
#     is the point: it deletes the "service is healthy, schema is stale"
#     cold-start class that a bare `ENTRYPOINT ["…", "python", "-m", "app"]`
#     leaves open. Set `KIT_MIGRATE=required` for a service that owns a schema,
#     so a misconfigured image fails loudly instead of serving the old one.
#     `docker/entrypoint.sh` finds `./bin/migrate` on its own; an Alembic service
#     sets `KIT_MIGRATE_CMD='alembic upgrade head'`, and Django sets
#     `KIT_MIGRATE_CMD='python manage.py migrate'`. Both run through the venv on
#     PATH, so neither needs an absolute path.
#   - `alembic upgrade head` is idempotent by construction — it compares the
#     `alembic_version` table to the files on disk — so replicas booting together
#     converge rather than collide. If you want that guaranteed rather than
#     likely, set `KIT_MIGRATE_ADVISORY_LOCK` and install `postgresql-client` in
#     the runtime stage; the entrypoint refuses to start if it is asked for a
#     lock it cannot take.
#   - `exec "$@"` inside that script, so after the migration python replaces the
#     shell and is PID 1: SIGTERM still reaches it.
ARG PYTHON_VERSION=3.13
ARG UV_VERSION=0.5.11

FROM python:${PYTHON_VERSION}-slim AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
COPY uv.lock* ./
RUN pip install "uv==${UV_VERSION}" \
    && if [ -f uv.lock ]; then uv export --frozen --no-dev --no-emit-project -o requirements.txt; \
       else printf '.\n' > requirements.txt; fi
COPY . .
RUN uv pip wheel --wheel-dir /wheels -r requirements.txt

FROM python:${PYTHON_VERSION}-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/app/.venv/bin:$PATH
WORKDIR /app

# --- the provenance stamp (kit) ----------------------------------------------
# Five ARGs, one file, five labels. WHICH formats this could have been, and the
# grammar that decides what may be stamped at all, are in docker/provenance.sh
# — do not restate them here, copy the script and read its header.
#
# `LABEL ${VAR}` is deliberately NOT used: buildkit does not word-split an
# expansion in a LABEL, so `LABEL ${STAMP}` fails with "must have two arguments"
# (measured). One ARG cannot carry five labels, so there are five.
#
# The defaults are `unknown` rather than empty, and that is the point: an image
# built with no --build-arg still carries the KEYS, because a missing label is
# indistinguishable from an image built before this existed.
ARG KIT_PROVENANCE_SOURCE=unknown
ARG KIT_PROVENANCE_REVISION=unknown
ARG KIT_PROVENANCE_BUILT_AT=unknown
ARG KIT_PROVENANCE_SOURCE_DIRTY=unknown
ARG KIT_PROVENANCE_TEMPLATE_VERSION=unknown
COPY docker/provenance.sh /usr/local/lib/kit/provenance.sh
RUN chmod +x /usr/local/lib/kit/provenance.sh \
    && /usr/local/lib/kit/provenance.sh --write /app/kit-provenance.json
LABEL org.opencontainers.image.source="${KIT_PROVENANCE_SOURCE}" \
      org.opencontainers.image.revision="${KIT_PROVENANCE_REVISION}" \
      org.opencontainers.image.created="${KIT_PROVENANCE_BUILT_AT}" \
      com.anywaye.kit.source.dirty="${KIT_PROVENANCE_SOURCE_DIRTY}" \
      com.anywaye.kit.template.version="${KIT_PROVENANCE_TEMPLATE_VERSION}"
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home app \
    && python -m venv /app/.venv
COPY --from=build /src/requirements.txt /tmp/requirements.txt
COPY --from=build /wheels /wheels
RUN /app/.venv/bin/pip install --no-cache-dir --no-index --find-links=/wheels -r /tmp/requirements.txt \
    && rm -rf /wheels /tmp/requirements.txt
# The service runs from /app with its own package directory. If it must be
# importable from outside the workdir, add
#   RUN /app/.venv/bin/pip install --no-index --no-deps /app
COPY --chown=app:app . /app
COPY --chown=app:app docker/entrypoint.sh /app/kit-entrypoint
USER app
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/app/kit-entrypoint", "/app/.venv/bin/python", "-m", "app"]
